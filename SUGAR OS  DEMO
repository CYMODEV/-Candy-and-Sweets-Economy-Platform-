function BetButton({ active, onClick, color, label }) {
  return <button onClick={onClick} className={`py-6 rounded-[24px] font-black text-lg text-white shadow-lg transition-all active:scale-95 ${active ? 'ring-4 ring-offset-2 ring-slate-200 opacity-90' : 'hover:brightness-110'} ${color}`}>{label}</button>;
}

function TabButton({ icon, active, onClick, activeClass }) {
  return (
    <button onClick={onClick} className={`w-full h-full flex flex-col items-center justify-center gap-1 transition-all duration-300 ${active ? '-translate-y-4' : 'text-slate-400 hover:text-slate-500'}`}>
      <div className={`w-12 h-12 rounded-[20px] flex items-center justify-center transition-all shadow-sm ${active ? `${activeClass} scale-110 shadow-lg rotate-3` : 'bg-transparent'}`}>{icon}</div>
      {active && <div className={`w-1.5 h-1.5 rounded-full ${activeClass.split(' ')[0].replace('text', 'bg')}`}></div>}
    </button>
