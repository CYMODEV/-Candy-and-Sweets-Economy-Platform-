}

function CreatorForm({ onCreate, category, theme }) {
  const [name, setName] = useState('');
  const [price, setPrice] = useState('');
  const [description, setDescription] = useState('');
  const [image, setImage] = useState(null);
  const [isGeneratingDesc, setIsGeneratingDesc] = useState(false);
  const [isGeneratingImg, setIsGeneratingImg] = useState(false);

  const handleMagicGenerate = async () => {
    if (!name) return;
    setIsGeneratingDesc(true);
    const result = await callGemini(`Write a fun, 1-sentence description for a ${category} item named "${name}". Make it sound delicious.`);
    setDescription(result);
    setIsGeneratingDesc(false);
  };

  const handleImageGenerate = async () => {
    if (!name) return;
    setIsGeneratingImg(true);
    const imgUrl = await generateImage(`${name} ${category} item. ${description}`);
    setImage(imgUrl);
    setIsGeneratingImg(false);
  };

  return (
    <div className="space-y-4 relative z-10">
       <div className="relative">
         <input className={`w-full border rounded-2xl px-5 py-4 text-base font-bold outline-none transition-all ${theme.textMain} ${theme.cardBg} border-slate-500/20`} placeholder="Item Name (e.g. Mega Sour)" value={name} onChange={e => setName(e.target.value)}/>
         <div className="absolute right-3 top-1/2 -translate-y-1/2 flex gap-1">
           <button onClick={handleMagicGenerate} disabled={!name || isGeneratingDesc} className="p-2 bg-amber-500/10 text-amber-600 rounded-xl hover:bg-amber-500/20 disabled:opacity-50 transition-colors">{isGeneratingDesc ? <Sparkles size={18} className="animate-spin" /> : <Wand2 size={18} />}</button>
           <button onClick={handleImageGenerate} disabled={!name || isGeneratingImg} className="p-2 bg-amber-500/10 text-amber-600 rounded-xl hover:bg-amber-500/20 disabled:opacity-50 transition-colors">{isGeneratingImg ? <Activity size={18} className="animate-spin" /> : <ImageIcon size={18} />}</button>
         </div>
       </div>
       {description && <div className="bg-amber-500/10 p-3 rounded-xl border border-amber-500/20 text-xs text-amber-600 font-medium italic animate-in fade-in">✨ "{description}"</div>}
       {image && <div className={`w-full h-32 rounded-2xl overflow-hidden border border-slate-500/20 flex items-center justify-center animate-in zoom-in shadow-inner ${theme.cardBg}`}><img src={image} alt="Generated Candy" className="h-full object-contain" /></div>}
       <div className="flex gap-3">
         <div className="relative w-1/2">
            <span className="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-xs">{getCategoryCoin(category)}</span>
            <input className={`w-full border rounded-2xl pl-14 pr-4 py-4 text-base font-bold outline-none transition-all ${theme.textMain} ${theme.cardBg} border-slate-500/20`} placeholder="Price" type="number" value={price} onChange={e => setPrice(e.target.value)}/>
         </div>
         <button onClick={() => { if(name && price) { onCreate(name, price, description, image, category); setName(''); setPrice(''); setDescription(''); setImage(null); }}} className="flex-1 bg-[#FF8906] hover:bg-[#e07805] text-white font-black rounded-2xl flex items-center justify-center gap-2 shadow-lg shadow-amber-200 active:scale-95 transition-all">REGISTER <Upload size={18} strokeWidth={3} /></button>
       </div>
    </div>
  );
}
