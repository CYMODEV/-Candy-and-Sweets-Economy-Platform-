function LearnTab({ learningProgress, onLearnComplete, theme }) {
  const [sageQuestion, setSageQuestion] = useState("");
  const [sageAnswer, setSageAnswer] = useState(null);
  const [isAskingSage, setIsAskingSage] = useState(false);
  const [dailyQuiz, setDailyQuiz] = useState(null);
  const audioRef = useRef(null);

  const handleAskSage = async () => {
    if (!sageQuestion.trim()) return;
    setIsAskingSage(true);
    setSageAnswer(null);
    const answer = await callGemini(`Explain this to a child using candy metaphors: "${sageQuestion}". Keep it under 2 sentences.`);
    setSageAnswer({ text: answer, audio: null });
    
    const audioUrl = await callGeminiTTS(answer);
    if (audioUrl) {
      setSageAnswer(prev => ({ ...prev, audio: audioUrl }));
    }
    
    setIsAskingSage(false);
  };

  const playSageAudio = () => {
    if (sageAnswer?.audio) {
      if (audioRef.current) {
        audioRef.current.pause();
        audioRef.current = null;
      }
      const audio = new Audio(sageAnswer.audio);
      audioRef.current = audio;
      audio.play();
    }
  };

  const handleGenerateQuiz = async () => {
    setDailyQuiz({ loading: true });
    const prompt = `Generate a multiple choice question about cryptocurrency for a child. Return ONLY raw JSON with keys: "question", "options" (array of 3 strings), and "correctIndex" (0-2).`;
    const jsonStr = await callGemini(prompt, true);
    try {
      const quizData = JSON.parse(jsonStr);
      setDailyQuiz({ ...quizData, answered: false });
    } catch (e) {
      setDailyQuiz({ error: true });
    }
  };

  return (
    <div className="pt-24 px-6 animate-in slide-in-from-right-8 duration-300 pb-32">
      <Header title="Academy" icon={<GraduationCap size={24} />} color="text-[#2CB67D]" theme={theme} />
      
      {/* CANDY SAGE */}
      <div className={`bg-gradient-to-br from-indigo-600 to-purple-700 p-6 rounded-[32px] text-white shadow-xl shadow-indigo-200 relative overflow-hidden mt-6`}>
        <div className="absolute top-0 right-0 p-4 opacity-20"><Bot size={80} /></div>
        <h3 className="text-lg font-black mb-1 flex items-center gap-2 relative z-10"><Sparkles size={18} className="text-yellow-300"/> The Candy Sage</h3>
        <p className="text-sm text-indigo-100 mb-4 relative z-10">Ask me anything!</p>
        <div className="bg-white/10 p-2 rounded-2xl flex items-center gap-2 border border-white/20 backdrop-blur-sm relative z-10">
          <input value={sageQuestion} onChange={(e) => setSageQuestion(e.target.value)} placeholder="What is 'Gas'?" className="bg-transparent flex-1 px-3 py-1 text-sm text-white placeholder:text-indigo-200 focus:outline-none font-medium"/>
          <button onClick={handleAskSage} className="p-2 bg-white text-indigo-600 rounded-xl hover:bg-indigo-50 transition-colors shadow-sm">{isAskingSage ? <Activity size={18} className="animate-spin"/> : <ChevronRight size={18} />}</button>
        </div>
        {sageAnswer && (
          <div className="mt-4 bg-white/10 p-4 rounded-xl text-sm leading-relaxed animate-in fade-in slide-in-from-bottom-2 border border-white/10 font-medium">
             "{sageAnswer.text}"
             {sageAnswer.audio && <button onClick={playSageAudio} className="mt-2 flex items-center gap-2 bg-indigo-500/50 hover:bg-indigo-500/70 px-3 py-1 rounded-lg text-xs font-bold transition-colors"><Volume2 size={14} /> Listen</button>}
          </div>
        )}
      </div>

      {/* DAILY QUIZ */}
      <div className="bg-[#2CB67D]/10 rounded-[32px] p-6 mt-6 border border-[#2CB67D]/20">
         <div className="flex justify-between items-center mb-4">
            <h3 className="font-black text-[#2CB67D] flex items-center gap-2"><HelpCircle size={18}/> Daily Challenge</h3>
            <button onClick={handleGenerateQuiz} className="text-xs bg-[#2CB67D] text-white px-3 py-1 rounded-lg font-bold shadow-sm active:scale-95 transition-transform">New Quiz</button>
         </div>
         {dailyQuiz?.loading ? <div className="text-center py-4 text-[#2CB67D] animate-pulse font-bold text-sm">Brewing a question... 🧪</div> : dailyQuiz?.question ? (
           <div className="animate-in fade-in">
             <p className={`font-bold mb-3 text-sm ${theme.textMain}`}>{dailyQuiz.question}</p>
             <div className="space-y-2">{dailyQuiz.options.map((opt, i) => (<button key={i} disabled={dailyQuiz.answered} onClick={() => setDailyQuiz(prev => ({...prev, answered: true, selected: i}))} className={`w-full text-left px-4 py-3 rounded-xl text-sm font-medium transition-colors ${dailyQuiz.answered ? i === dailyQuiz.correctIndex ? 'bg-green-500 text-white' : i === dailyQuiz.selected ? 'bg-red-400 text-white' : `bg-white/50 text-slate-400` : `bg-white/80 ${theme.textSec} hover:bg-[#2CB67D]/10`}`}>{opt}</button>))}</div>
           </div>
         ) : <p className="text-xs text-slate-400 text-center">Tap "New Quiz" to test your brain!</p>}
      </div>

      <div className="space-y-5 mt-6">
        {learningProgress.map((module, idx) => (
          <div key={module.id} className={`p-6 rounded-[32px] border transition-all relative overflow-hidden group ${theme.cardBg} ${module.completed ? 'border-emerald-100 opacity-60' : 'border-slate-100 shadow-xl shadow-emerald-50 hover:-translate-y-1'}`}>
              <div className="absolute left-0 top-0 bottom-0 w-1.5 bg-slate-500/10"><div className={`w-full bg-[#2CB67D] transition-all duration-1000 ${module.completed ? 'h-full' : 'h-0'}`}></div></div>
              <div className="pl-4">
                <div className="flex justify-between items-start mb-3">
                  <span className="bg-emerald-500/20 text-[#2CB67D] px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide">Lesson {idx + 1}</span>
                  {module.completed ? <div className="w-8 h-8 bg-[#2CB67D] rounded-full flex items-center justify-center text-white shadow-lg shadow-emerald-200"><CheckCircle size={16} /></div> : <div className="flex items-center gap-1 text-xs font-bold text-orange-500 bg-orange-500/10 px-2 py-1 rounded-lg border border-orange-500/20"><Coins size={12} fill="currentColor" /> +{module.reward}</div>}
                </div>
                <h3 className={`font-bold text-xl mb-2 ${theme.textMain}`}>{module.title}</h3>
                <p className={`text-sm leading-relaxed mb-4 ${theme.textSec}`}>{module.content}</p>
                {!module.completed && <button onClick={() => onLearnComplete(module.id)} className="w-full py-3.5 bg-[#2CB67D] hover:bg-[#25a06d] text-white rounded-2xl font-bold text-sm shadow-lg shadow-emerald-200 active:scale-95 transition-all">Complete Lesson</button>}
              </div>
          </div>
        ))}
      </div>
    </div>
  );
}

function CreateTab({ onCreateItem, userCreations, onFuse, onUserItemSponsor, theme, wallet }) {
  const [mode, setMode] = useState('mint'); // 'mint' or 'fuse'
  const [base1, setBase1] = useState(FUSION_BASES[0]);
  const [base2, setBase2] = useState(FUSION_BASES[1]);
  const [isFusing, setIsFusing] = useState(false);
  const [category, setCategory] = useState('CANDY');

  const triggerFuse = async () => {
    setIsFusing(true);
    await onFuse(base1, base2);
    setIsFusing(false);
  };

  return (
    <div className="pt-24 px-6 animate-in slide-in-from-right-8 duration-300 pb-32">
      <Header title="Sweet Shop" icon={<Store size={24} />} color="text-[#FF8906]" theme={theme} />
      
      {/* Mode Switch */}
      <div className="flex bg-orange-500/10 rounded-xl p-1 mb-4 mt-6">
        <button onClick={() => setMode('mint')} className={`flex-1 py-2 text-xs font-bold rounded-lg transition-all ${mode === 'mint' ? `bg-white shadow-sm text-orange-600` : 'text-orange-400'}`}>REGISTRY</button>
        <button onClick={() => setMode('fuse')} className={`flex-1 py-2 text-xs font-bold rounded-lg transition-all ${mode === 'fuse' ? `bg-white shadow-sm text-purple-600` : 'text-orange-400'}`}>FUSION LAB</button>
      </div>

      {mode === 'mint' ? (
        <div className={`p-6 rounded-[36px] shadow-xl shadow-amber-100/20 border border-amber-500/20 relative overflow-hidden ${theme.cardBg}`}>
            <div className="absolute top-0 right-0 w-24 h-24 bg-amber-500/10 rounded-bl-[100px] -z-0"></div>
            <div className="flex justify-between items-center mb-6 relative z-10">
               <div className="flex items-center gap-2 text-[#FF8906] font-bold text-xs uppercase tracking-widest"><Hammer size={14} /> Official Registry</div>
               <div className="text-[10px] bg-green-500/10 text-green-600 px-2 py-1 rounded font-bold border border-green-500/20">Reward: 100 Base Coins</div>
            </div>
            
            {/* Category Selector */}
            <div className="flex gap-5 overflow-x-auto no-scrollbar mb-6 relative z-10 justify-start pb-2">
              {CATEGORIES.map(c => {
                 let CatIcon = Candy;
                 if (c === 'FROZEN') CatIcon = IceCream;
                 if (c === 'BAKERY') CatIcon = Croissant;
                 if (c === 'SODA') CatIcon = Droplet;
                 
                 const isActive = category === c;
                 return (
                  <button 
                    key={c} 
                    onClick={() => setCategory(c)}
                    className={`flex-shrink-0 flex flex-col items-center gap-2 transition-all ${isActive ? 'scale-110 opacity-100' : 'opacity-50 hover:opacity-100'}`}
                  >
                    <div className={`w-12 h-12 rounded-full flex items-center justify-center shadow-md border ${isActive ? `bg-[#FF8906] text-white border-[#FF8906]` : `bg-white/50 text-slate-500 border-slate-200 backdrop-blur-sm`}`}>
                       <CatIcon size={20} />
                    </div>
                    <span className={`text-[10px] font-black uppercase tracking-wider ${isActive ? 'text-[#FF8906]' : theme.textSec}`}>{c}</span>
                  </button>
                 );
              })}
            </div>

            <CreatorForm onCreate={onCreateItem} category={category} theme={theme} />
        </div>
      ) : (
        <div className={`p-6 rounded-[36px] shadow-xl shadow-purple-500/20 border border-purple-500/20 relative overflow-hidden ${theme.cardBg}`}>
            <div className="flex items-center gap-2 mb-4 text-purple-500 font-bold text-xs uppercase tracking-widest relative z-10"><FlaskConical size={14} /> Fusion Kitchen</div>
            
            <div className="text-[10px] font-bold text-purple-400 bg-purple-500/10 p-2 rounded-lg border border-purple-500/20 mb-6">
              Cost: 15 of EACH Base Coin (CNDY, SWET, FROZ, SODA)
            </div>

            <div className="flex gap-2 mb-4">
              <select value={base1} onChange={e => setBase1(e.target.value)} className={`flex-1 p-3 rounded-xl text-sm font-bold border outline-none bg-transparent ${theme.textMain} border-purple-500/20`}>
                {FUSION_BASES.map(b => <option key={b} value={b} className="bg-slate-800 text-white">{b}</option>)}
              </select>
              <div className="flex items-center justify-center font-black text-purple-300">+</div>
              <select value={base2} onChange={e => setBase2(e.target.value)} className={`flex-1 p-3 rounded-xl text-sm font-bold border outline-none bg-transparent ${theme.textMain} border-purple-500/20`}>
                {FUSION_BASES.map(b => <option key={b} value={b} className="bg-slate-800 text-white">{b}</option>)}
              </select>
            </div>

            <button onClick={triggerFuse} disabled={isFusing} className="w-full bg-purple-600 hover:bg-purple-700 text-white font-black py-4 rounded-2xl shadow-lg shadow-purple-200 transition-all active:scale-95 flex items-center justify-center gap-2">
              {isFusing ? <RefreshCw className="animate-spin"/> : "🧬 FUSE CANDY"}
            </button>
        </div>
      )}

      <div className="mt-8">
          <h3 className={`font-bold text-xs uppercase tracking-widest mb-4 ml-2 ${theme.textSec}`}>Your Registered Creations</h3>
          {userCreations.length === 0 ? (
            <div className={`text-center p-8 rounded-[32px] border-2 border-dashed ${theme.textSec} border-slate-500/20`}><div className="text-4xl mb-2">📦</div><p className="text-sm font-medium">Registry Empty!</p></div>
          ) : (
            <div className="grid grid-cols-2 gap-4">
              {userCreations.map(item => (
                <div key={item.id} className={`p-4 rounded-[28px] shadow-sm border border-slate-500/10 flex flex-col items-center text-center group hover:-translate-y-1 transition-transform duration-300 ${theme.cardBg}`}>
                    <div className="w-16 h-16 bg-gradient-to-br from-pink-100 to-amber-100 rounded-2xl mb-3 flex items-center justify-center text-3xl shadow-inner group-hover:scale-110 transition-transform relative overflow-hidden">
                      {item.image ? <img src={item.image} alt={item.name} className="w-full h-full object-cover" /> : '🍬'}
                    </div>
                    <div className={`font-bold text-sm w-full truncate ${theme.textMain}`}>{item.name}</div>
                    <div className="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">{item.category}</div>
                    <div className={`text-[10px] line-clamp-2 min-h-[2.5em] mb-2 ${theme.textSec}`}>{item.description}</div>
                    
                    {item.sponsor ? (
                      <div className="w-full bg-indigo-500/10 text-indigo-500 text-[10px] font-bold py-1 rounded-lg border border-indigo-500/20">
                        w/ {item.sponsor}
                      </div>
                    ) : (
                      <button onClick={() => onUserItemSponsor(item.id)} className="w-full bg-green-500/10 text-green-600 hover:bg-green-500/20 text-[10px] font-bold py-1 rounded-lg border border-green-500/20 transition-colors">
                        GET SPONSOR
                      </button>
                    )}
                </div>
              ))}
            </div>
          )}
      </div>
    </div>
  );
}

function ProfileTab({ wallet, onSetAvatar, onReset, appTheme, setAppTheme, theme }) {
  const [avatarPrompt, setAvatarPrompt] = useState("");
  const [isGenerating, setIsGenerating] = useState(false);

  const handleGenerate = async () => {
    if (!avatarPrompt) return;
    setIsGenerating(true);
    const url = await generateImage(avatarPrompt);
    if (url) onSetAvatar(url);
    setIsGenerating(false);
  };

  const nextLevel = LEVELS.find(l => l.xp > wallet.xp) || LEVELS[LEVELS.length-1];
  const progress = Math.min(100, (wallet.xp / nextLevel.xp) * 100);

  return (
    <div className="pt-24 px-6 animate-in slide-in-from-right-8 duration-300 pb-32">
      <Header title="My Profile" icon={<User size={24} />} color="text-cyan-500" theme={theme} />
      
      {/* Theme Selector */}
      <div className="flex gap-6 mb-6 mt-6 overflow-x-auto no-scrollbar pb-2 px-2">
        {Object.values(THEMES).map(t => {
          const isActive = appTheme === t.id;
          return (
          <button 
            key={t.id} 
            onClick={() => setAppTheme(t.id)}
            className={`flex-shrink-0 flex flex-col items-center gap-2 transition-all ${isActive ? 'scale-110 opacity-100' : 'opacity-60 hover:opacity-100'}`}
          >
             <div className={`w-14 h-14 rounded-full flex items-center justify-center shadow-lg border ${isActive ? `${theme.accentBg} text-white border-transparent` : `${theme.cardBg} ${theme.textSec} border-slate-500/10`}`}>
               <Palette size={24}/> 
             </div>
             <span className={`text-[10px] font-black uppercase tracking-wider ${isActive ? theme.accent : theme.textSec}`}>{t.name}</span>
          </button>
        )})}
      </div>

      {/* Avatar Card */}
      <div className={`rounded-[40px] p-6 shadow-xl border border-cyan-500/20 text-center relative overflow-hidden ${theme.cardBg}`}>
         <div className="w-32 h-32 bg-cyan-100 rounded-full mx-auto mb-4 overflow-hidden border-4 border-white shadow-lg relative group">
            {wallet.avatar ? <img src={wallet.avatar} className="w-full h-full object-cover" alt="avatar"/> : <div className="w-full h-full flex items-center justify-center text-4xl">😎</div>}
            <div className="absolute inset-0 bg-black/20 hidden group-hover:flex items-center justify-center text-white text-xs font-bold cursor-pointer" onClick={() => setAvatarPrompt("Cyberpunk candy trader")}>Edit</div>
         </div>
         <h2 className={`text-2xl font-black ${theme.textMain}`}>{wallet.title}</h2>
         <p className={`text-sm font-medium ${theme.textSec}`}>Level {wallet.level} Trader</p>
         
         {/* Level Progress */}
         <div className="mt-6 text-left">
            <div className={`flex justify-between text-xs font-bold mb-2 ${theme.textSec}`}>
               <span>XP: {wallet.xp}</span>
               <span>Next: {nextLevel.xp}</span>
            </div>
            <div className="h-3 w-full bg-slate-500/10 rounded-full overflow-hidden">
               <div className="h-full bg-cyan-500 transition-all duration-1000" style={{ width: `${progress}%` }}></div>
            </div>
         </div>

         {/* AI Generator */}
         <div className="mt-6 pt-6 border-t border-slate-500/10">
            <p className="text-xs font-bold text-cyan-600 mb-2 uppercase tracking-wide">AI Avatar Studio</p>
            <div className="flex gap-2">
               <input 
                 value={avatarPrompt} 
                 onChange={e => setAvatarPrompt(e.target.value)}
                 placeholder="e.g. A cool gummy bear with sunglasses" 
                 className={`flex-1 rounded-xl px-3 py-2 text-xs font-medium outline-none bg-slate-500/5 ${theme.textMain}`}
               />
               <button onClick={handleGenerate} disabled={isGenerating || !avatarPrompt} className="bg-cyan-500 text-white p-2 rounded-xl">
                 {isGenerating ? <RefreshCw className="animate-spin" size={16}/> : <Wand2 size={16}/>}
               </button>
            </div>
         </div>
      </div>

      {/* Trophy Room */}
      <div className="mt-6">
         <h3 className={`font-black mb-4 flex items-center gap-2 ${theme.textMain}`}><Award className="text-yellow-500"/> Trophy Room</h3>
         <div className="grid grid-cols-2 gap-3">
            {ACHIEVEMENTS.map(ach => {
               const unlocked = wallet.achievements.includes(ach.id);
               return (
                 <div key={ach.id} className={`p-4 rounded-3xl border transition-all ${unlocked ? 'bg-yellow-500/10 border-yellow-500/30 shadow-sm' : 'bg-slate-500/5 border-transparent opacity-50 grayscale'}`}>
                    <div className="text-3xl mb-2">{ach.icon}</div>
                    <div className={`font-bold text-sm leading-tight ${theme.textMain}`}>{ach.title}</div>
                    <div className={`text-[10px] ${theme.textSec}`}>{ach.desc}</div>
                 </div>
               );
            })}
         </div>
      </div>

      {/* Leaderboard */}
      <div className="bg-gradient-to-br from-yellow-400 to-orange-500 rounded-[40px] p-6 shadow-xl shadow-orange-200 mt-6 text-white relative overflow-hidden">
         <div className="flex items-center gap-2 mb-4 font-black text-lg"><Crown size={24}/> Global Top 3</div>
         <div className="space-y-3 relative z-10">
            {MOCK_LEADERBOARD.map((p, i) => (
               <div key={p.id} className="flex items-center gap-4 bg-white/20 p-3 rounded-2xl backdrop-blur-sm border border-white/10">
                  <div className="font-black text-xl w-6">#{i+1}</div>
                  <div className="text-2xl">{p.avatar}</div>
                  <div className="flex-1 font-bold">{p.name}</div>
                  <div className="font-mono text-sm opacity-90">{p.netWorth.toLocaleString()}</div>
               </div>
            ))}
            <div className="flex items-center gap-4 bg-white/90 text-slate-800 p-3 rounded-2xl shadow-lg transform scale-105 border-2 border-white">
               <div className="font-black text-xl w-6">#4</div>
               <div className="text-2xl">😎</div>
               <div className="flex-1 font-bold">YOU</div>
               <div className="font-mono text-sm font-bold">{(wallet.CNDY + wallet.SWET + wallet.FROZ + wallet.SODA + wallet.CIDX * 20).toLocaleString()}</div>
            </div>
         </div>
      </div>

      {/* Factory Reset */}
      <div className="mt-8 text-center">
        <button onClick={onReset} className="text-xs text-red-400 font-bold flex items-center justify-center gap-2 mx-auto hover:bg-red-500/10 px-4 py-2 rounded-xl transition-colors">
          <Trash2 size={14}/> Factory Reset Game
        </button>
      </div>
    </div>
  );
}

