const generateMarketData = (modifiers = {}) => {
  return {
    categories: CATEGORIES.map(cat => {
      const mod = modifiers[cat] || { sales: 1, sentiment: 0 };
      const baseSales = cat === 'CANDY' ? 300 : cat === 'FROZEN' ? 200 : cat === 'BAKERY' ? 150 : 250;
      return {
        name: cat,
        sales: Math.floor(rnd(50, baseSales) * (mod.sales || 1)),
        sentiment: Math.min(1, Math.max(0, Number((Math.random() * (0.95 - 0.4) + 0.4 + (mod.sentiment || 0)).toFixed(2)))),
        momentum: Number((Math.random() * (1.3 - 0.8) + 0.8).toFixed(2))
      };
    })
  };
};

const computeCMI = (marketData) => {
  let totalScore = 0;
  marketData.categories.forEach(cat => {
    totalScore += (cat.sales * 0.6) + (cat.sentiment * 100 * 0.3) + (cat.momentum * 100 * 0.2);
  });
  const base = 1000;
  return Math.floor(base + totalScore / 4);
};

