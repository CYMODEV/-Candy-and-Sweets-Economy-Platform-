}

function BigCard({ onClick, theme, icon, title, subtitle }) {
  return (
    <div onClick={onClick} className={`p-1.5 rounded-[32px] cursor-pointer active:scale-98 transition-transform ${theme.cardBg} shadow-sm border border-slate-500/10`}>
       <div className={`p-5 rounded-[28px] flex items-center gap-5 backdrop-blur-sm`}>
          <div className={`w-16 h-16 rounded-[20px] flex items-center justify-center shadow-md transform rotate-3 ${theme.playBg}`}>{icon}</div>
          <div><h3 className={`font-bold text-lg leading-tight ${theme.textMain}`}>{title}</h3><p className={`text-sm font-medium ${theme.textSec}`}>{subtitle}</p></div>
