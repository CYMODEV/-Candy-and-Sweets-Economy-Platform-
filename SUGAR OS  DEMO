  const [viewMode, setViewMode] = useState('mobile'); 
  
  // Market State
  const [marketData, setMarketData] = useState(generateMarketData());
  const [cmi, setCmi] = useState(1210);
  const [history, setHistory] = useState(Array(20).fill(1210));
  const [marketModifiers, setMarketModifiers] = useState({});
  const [topSweets, setTopSweets] = useStickyState('candyman_top_sweets', INITIAL_TOP_SWEETS);
  
  // Persistent User State
  const [wallet, setWallet] = useStickyState('candyman_wallet_v2', INITIAL_WALLET);
  const [learningProgress, setLearningProgress] = useStickyState('candyman_learning', LEARNING_MODULES);
  const [userCreations, setUserCreations] = useStickyState('candyman_creations', []);
  const [questProgress, setQuestProgress] = useStickyState('candyman_quests', { mint: 0, swap: 0, bet: 0, sponsor: 0 });
  const [appTheme, setAppTheme] = useStickyState('candyman_theme', 'sugar');

  const [transactions, setTransactions] = useState([
    { id: 1, type: "MINT", asset: "CNDY", amount: 1000, time: "10m ago" },
    { id: 2, type: "SWAP", asset: "CIDX", amount: 50, time: "5m ago" }
  ]);
  
  // Ephemeral State
  const [notifications, setNotifications] = useState([]);
  const [activeBet, setActiveBet] = useState(null); 
  const [gameResult, setGameResult] = useState(null); 
  const [bubbles, setBubbles] = useState([]);
  const [isPlayingMusic, setIsPlayingMusic] = useState(false);
  const [analystReport, setAnalystReport] = useState("");
  const [betStreak, setBetStreak] = useState(0);

  const theme = THEMES[appTheme] || THEMES.sugar;

  // --- LOOPS ---
  useEffect(() => {
    const interval = setInterval(() => {
      const newData = generateMarketData(marketModifiers);
      const newCMI = computeCMI(newData);
      
      // Game Logic (Betting)
      if (activeBet) {
        const isWin = (activeBet.type === 'UP' && newCMI > activeBet.startPrice) ||
                      (activeBet.type === 'DOWN' && newCMI < activeBet.startPrice);
        
        if (isWin) {
          const multiplier = 1 + (betStreak * 0.2);
          const payout = Math.floor(activeBet.amount * 2 * multiplier);
          addTransaction("WIN", "CNDY", payout);
          updateWallet({ CNDY: payout }, 50); 
          updateQuest('bet');
          setGameResult('WIN');
          setBetStreak(s => s + 1);
          spawnBubble();
        } else {
          setGameResult('LOSS');
          setBetStreak(0);
        }
        setActiveBet(null);
      }

      // Passive Income (Staking + Sponsored Items)
      if (wallet.stakedCIDX > 0) {
        const yieldAmount = Math.floor(wallet.stakedCIDX * 0.05); 
        if (yieldAmount > 0) {
           updateWallet({ CNDY: yieldAmount }, 0); 
        }
      }

      // Sponsored Creations Yield
      const sponsoredItems = userCreations.filter(i => i.sponsor);
      if (sponsoredItems.length > 0) {
        const sponsorYield = sponsoredItems.length * 2;
        updateWallet({ CNDY: sponsorYield }, 0);
      }
      
      setMarketData(newData);
      setCmi(newCMI);
      setHistory(prev => [...prev.slice(1), newCMI]);
    }, 2000); 

    return () => clearInterval(interval);
  }, [activeBet, userCreations, marketModifiers, wallet.stakedCIDX]);

  // Achievement Check Loop
  useEffect(() => {
    ACHIEVEMENTS.forEach(ach => {
      if (!wallet.achievements.includes(ach.id) && ach.condition(wallet)) {
        setWallet(prev => ({ ...prev, achievements: [...prev.achievements, ach.id] }));
        pushNotification(`Unlocked: ${ach.title} ${ach.icon}`);
        spawnBubble();
      }
    });
  }, [wallet]);

  // Bubble Physics
  useEffect(() => {
    if (bubbles.length === 0) return;
    const interval = setInterval(() => {
      setBubbles(prev => prev
        .map(b => ({ ...b, y: b.y - b.speed, opacity: b.opacity - 0.02 }))
        .filter(b => b.opacity > 0)
      );
    }, 50);
    return () => clearInterval(interval);
  }, [bubbles]);

  // --- HELPER ACTIONS ---
  
  const handleReset = () => {
    if(confirm("Factory Reset: Wipe all progress and start over?")) {
      localStorage.clear();
      window.location.reload();
    }
  };

  const updateWallet = (changes, xpChange = 0) => {
    setWallet(prev => {
      const newXP = prev.xp + xpChange;
      const newLevelData = LEVELS.slice().reverse().find(l => newXP >= l.xp) || LEVELS[0];
      const prevLevelData = LEVELS.slice().reverse().find(l => prev.xp >= l.xp) || LEVELS[0];
      
      if (newLevelData.title !== prevLevelData.title) {
        pushNotification(`Level Up! You are now a ${newLevelData.title}`);
      }

      return {
        ...prev,
        CNDY: prev.CNDY + (changes.CNDY || 0),
        SWET: prev.SWET + (changes.SWET || 0),
        FROZ: prev.FROZ + (changes.FROZ || 0),
        SODA: prev.SODA + (changes.SODA || 0),
        CIDX: prev.CIDX + (changes.CIDX || 0),
        stakedCIDX: prev.stakedCIDX + (changes.stakedCIDX || 0),
        miningPower: (prev.miningPower || 1) + (changes.miningPower || 0),
        xp: newXP,
        level: LEVELS.indexOf(newLevelData) + 1,
        title: newLevelData.title
      };
    });
  };

  const updateQuest = (type) => {
    setQuestProgress(prev => {
      const current = prev[type] || 0;
      const quest = DAILY_QUESTS.find(q => q.id === type);
      if (quest && current < quest.target) {
        const newVal = current + 1;
        if (newVal === quest.target) {
          updateWallet({ CNDY: quest.reward }, 50);
          pushNotification(`Quest Complete: ${quest.label}`);
        }
        return { ...prev, [type]: newVal };
      }
      return prev;
    });
  };

  const addTransaction = (type, asset, amount) => {
    const newTx = {
      id: Date.now(),
      type,
      asset,
      amount: Number(amount).toFixed(2),
      time: "Just now"
    };
    setTransactions(prev => [newTx, ...prev].slice(0, 10)); 
  };

  const pushNotification = (msg) => {
    const id = Date.now();
    setNotifications(prev => [...prev, { id, msg }]);
    setTimeout(() => setNotifications(prev => prev.filter(n => n.id !== id)), 3000);
  };

  const spawnBubble = () => {
    const newBubble = {
      id: Math.random(),
      x: rnd(10, 90), y: 90, size: rnd(30, 70), speed: rnd(2, 4),
      color: ['bg-pink-400', 'bg-cyan-400', 'bg-purple-400', 'bg-yellow-400'][rnd(0, 4)],
      opacity: 1
    };
    setBubbles(prev => [...prev, newBubble]);
  };

  // --- USER ACTIONS ---

  const handleSwap = (direction, amount, asset = 'CNDY') => {
    const rate = 20; 
    if (direction === 'TO_CIDX') {
       if (wallet[asset] >= amount) {
         updateWallet({ [asset]: -amount, CIDX: amount / rate }, 10); 
         addTransaction("SWAP", "CIDX", amount/rate);
         updateQuest('swap');
         spawnBubble();
       } else {
         pushNotification(`Not enough ${asset}!`);
       }
    } else { // FROM CIDX
       if (wallet.CIDX >= amount) {
         updateWallet({ [asset]: amount * rate, CIDX: -amount }, 10);
         addTransaction("SWAP", asset, amount * rate);
         updateQuest('swap');
         spawnBubble();
       } else {
         pushNotification("Not enough CIDX!");
       }
    }
  };

  const handleStake = (amount) => {
    if (wallet.CIDX >= amount) {
      updateWallet({ CIDX: -amount, stakedCIDX: amount }, 20); 
      addTransaction("STAKE", "CIDX", amount);
      spawnBubble();
    }
  };

  const handleUnstake = (amount) => {
    if (wallet.stakedCIDX >= amount) {
      updateWallet({ stakedCIDX: -amount, CIDX: amount }, 0);
      addTransaction("UNSTAKE", "CIDX", amount);
    }
  };

  const handleMining = () => {
    const coins = ['CNDY', 'SWET', 'FROZ', 'SODA'];
    const minedCoin = coins[rnd(0, coins.length)];
    const baseAmount = rnd(3, 8);
    const totalMined = baseAmount * (wallet.miningPower || 1);
    updateWallet({ [minedCoin]: totalMined }, 1); 
    pushNotification(`Mined ${totalMined} ${minedCoin}!`);
    spawnBubble();
  };

  const handleUpgradeMiner = () => {
    const cost = (wallet.miningPower || 1) * 100;
    if (wallet.CNDY >= cost) {
      updateWallet({ CNDY: -cost, miningPower: 1 }, 20);
      pushNotification(`Miner upgraded to Lv ${(wallet.miningPower || 1) + 1}!`);
      spawnBubble();
    } else {
      pushNotification(`Need ${cost} CNDY to upgrade!`);
    }
  };

  const handlePlaceBet = (type) => {
    if (wallet.CNDY < 10) return;
    updateWallet({ CNDY: -10 }, 0); 
    setActiveBet({ type, amount: 10, startPrice: cmi });
    addTransaction("BET", "CNDY", -10);
    setGameResult(null);
  };

  const handleLearnComplete = (id) => {
    const module = learningProgress.find(m => m.id === id);
    if (module && !module.completed) {
      updateWallet({ CNDY: module.reward }, module.xp);
      setLearningProgress(prev => prev.map(m => m.id === id ? { ...m, completed: true } : m));
      addTransaction("EARN", "CNDY", module.reward);
      spawnBubble();
    }
  };

  const handleCreateItem = (name, price, description, image, category = 'CANDY') => {
    const newItem = { id: Date.now(), name, price, description, image, category, sponsor: null };
    const coinRewarded = getCategoryCoin(category);
    setUserCreations([newItem, ...userCreations]);
    updateWallet({ [coinRewarded]: 100 }, 100); // Reward for minting
    updateQuest('mint');
    addTransaction("MINT", coinRewarded, 100);
    pushNotification(`Registry bonus: +100 ${coinRewarded}`);
    spawnBubble();
  };

  // --- NEW FUSION FEATURE ---
  const handleFuseItem = async (base1, base2) => {
    const cost = 15;
    if (wallet.CNDY < cost || wallet.SWET < cost || wallet.FROZ < cost || wallet.SODA < cost) {
      pushNotification(`Need ${cost} of EVERY base coin to fuse!`);
      return;
    }
    updateWallet({ CNDY: -cost, SWET: -cost, FROZ: -cost, SODA: -cost }, 150); 

    const prompt = `Combine the candy flavors/concepts "${base1}" and "${base2}" into a new unique fantasy candy. Return JSON: {"name": "...", "description": "...", "price": (100-800), "category": "One of [CANDY, FROZEN, BAKERY, SODA]" }`;
    const jsonStr = await callGemini(prompt, true);
    
    try {
      const data = JSON.parse(jsonStr);
      const imgUrl = await generateImage(data.name + ", " + data.description);
      handleCreateItem(data.name, data.price, data.description, imgUrl, data.category || 'CANDY');
      pushNotification(`Fused: ${data.name}!`);
    } catch(e) {
      console.error(e);
      pushNotification("Fusion failed! Ingredients lost.");
    }
  };

  const handleSetAvatar = (avatarUrl) => {
    setWallet(prev => ({ ...prev, avatar: avatarUrl }));
    updateWallet({}, 50); 
  };

  const handleAnalyzeMarket = async () => {
    if(!marketData) return;
    setAnalystReport("Analyzing...");
    const report = await callGemini(`
      Act as a funny, hype-man financial analyst for a global sweets market.
      Market Data: ${JSON.stringify(marketData)}.
      Current CMI Index: ${cmi}.
      Write a 1-sentence "Breaking News" alert about which category (Candy, Frozen, Bakery, Soda) is winning. Use emojis.
    `);
    setAnalystReport(report || "Market data is strange today...");
  };

  const handleChaosEvent = async (scenario) => {
    setAnalystReport("⚠️ CALCULATING CHAOS IMPACT...");
    const jsonStr = await callGemini(`
      Scenario: "${scenario}".
      Categories: ${CATEGORIES.join(', ')}.
      Return JSON: keys=categories, values={sales (float 0.1-2.0), sentiment (float -0.8 to 0.8)}.
    `, true);
    
    try {
      const modifiers = JSON.parse(jsonStr);
      setMarketModifiers(modifiers);
      spawnBubble();
      setTimeout(() => setMarketModifiers({}), 10000);
    } catch (e) {
      console.error("Chaos parse error", e);
    }
  };

  // --- AI SPONSOR SCOUT ---
  const handleSponsorGen = async (id, type, flavor) => {
    const prompt = `Generate a funny fictional brand sponsor for a treat called '${flavor}' (${type}). Return JSON with: { "brand": "BrandName", "slogan": "Short Slogan", "bonus": "+XX%" }`;
    const jsonStr = await callGemini(prompt, true);
    try {
      const data = JSON.parse(jsonStr);
      return data;
    } catch (e) {
      console.error("Sponsor gen error", e);
      return null;
    }
  };

  const handleUserItemSponsor = async (itemId) => {
    const item = userCreations.find(i => i.id === itemId);
    if (!item) return;
    
    const sponsorData = await handleSponsorGen(itemId, item.category, item.name);
    if (sponsorData) {
      setUserCreations(prev => prev.map(i => i.id === itemId ? { ...i, sponsor: sponsorData.brand, sponsorData } : i));
      updateQuest('sponsor');
      pushNotification(`Sponsored by ${sponsorData.brand}!`);
      spawnBubble();
    } else {
      pushNotification("No sponsors interested right now.");
    }
  };

  return (
    <div className={`min-h-screen font-sans transition-all duration-700 overflow-hidden relative selection:bg-cyan-500 selection:text-white ${theme.bg}`}>
      <style>{`
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        @keyframes orbit1 {
          0% { transform: rotateZ(30deg) rotateX(75deg) rotateZ(0deg); }
          100% { transform: rotateZ(30deg) rotateX(75deg) rotateZ(360deg); }
        }
        @keyframes orbit2 {
          0% { transform: rotateZ(-30deg) rotateX(75deg) rotateZ(0deg); }
          100% { transform: rotateZ(-30deg) rotateX(75deg) rotateZ(-360deg); }
        }
        @keyframes orbit3 {
          0% { transform: rotateZ(90deg) rotateX(75deg) rotateZ(0deg); }
          100% { transform: rotateZ(90deg) rotateX(75deg) rotateZ(360deg); }
        }
      `}</style>
      
      {/* Notifications Toast */}
      <div className="fixed top-4 left-1/2 -translate-x-1/2 z-[100] flex flex-col gap-2 pointer-events-none">
        {notifications.map(n => (
          <div key={n.id} className="bg-white/90 backdrop-blur shadow-xl rounded-2xl px-6 py-3 border border-pink-200 text-sm font-bold text-pink-600 animate-in slide-in-from-top-4 flex items-center gap-2">
            <Bell size={16}/> {n.msg}
          </div>
        ))}
      </div>

      {/* View Switcher */}
      <div className="fixed bottom-6 right-6 z-50 flex bg-white/5 backdrop-blur-2xl rounded-full shadow-[0_8px_32px_0_rgba(31,38,135,0.37)] border border-white/10 p-1.5 transform hover:scale-105 transition-transform duration-300">
        <button 
          onClick={() => setViewMode('web')}
          className={`px-6 py-3 rounded-full flex items-center gap-2 transition-all font-bold text-sm tracking-wide ${viewMode === 'web' ? 'bg-cyan-500 text-black shadow-[0_0_20px_rgba(6,182,212,0.5)]' : 'text-slate-400 hover:bg-white/10 hover:text-white'}`}
        >
          <Monitor size={16} /> PRO
        </button>
        <button 
          onClick={() => setViewMode('mobile')}
          className={`px-6 py-3 rounded-full flex items-center gap-2 transition-all font-bold text-sm tracking-wide ${viewMode === 'mobile' ? 'bg-pink-500 text-white shadow-[0_0_20px_rgba(236,72,153,0.5)]' : 'text-slate-400 hover:bg-white/10 hover:text-white'}`}
        >
          <Smartphone size={16} /> LITE
        </button>
      </div>

      {viewMode === 'web' ? (
        <WebDashboard 
          cmi={cmi} 
          marketData={marketData} 
          wallet={wallet} 
          history={history}
          userCreations={userCreations}
          transactions={transactions}
          onAnalyze={handleAnalyzeMarket}
          analystReport={analystReport}
          onSwap={handleSwap}
          onStake={handleStake}
          onUnstake={handleUnstake}
          topSweets={topSweets}
          theme={theme}
          appTheme={appTheme}
          setAppTheme={setAppTheme}
          onSponsorGen={async (id, type, flavor) => {
             const data = await handleSponsorGen(id, type, flavor);
             if (data) {
                setTopSweets(prev => prev.map(f => f.id === id ? { ...f, sponsor: data.brand, yield: data.bonus, sponsorData: data } : f));
             }
          }}
        />
      ) : (
        <MobileApp 
          cmi={cmi} 
          wallet={wallet}
          transactions={transactions}
          bubbles={bubbles}
          isPlayingMusic={isPlayingMusic}
          toggleMusic={() => setIsPlayingMusic(!isPlayingMusic)}
          activeBet={activeBet}
          onPlaceBet={handlePlaceBet}
          gameResult={gameResult}
          learningProgress={learningProgress}
          onLearnComplete={handleLearnComplete}
          onCreateItem={handleCreateItem}
          userCreations={userCreations}
          onAnalyze={handleAnalyzeMarket}
          analystReport={analystReport}
          onSwap={handleSwap}
          onChaos={handleChaosEvent}
          onStake={handleStake}
          onUnstake={handleUnstake}
          onMining={handleMining}
          onUpgradeMiner={handleUpgradeMiner}
          betStreak={betStreak}
          onSetAvatar={handleSetAvatar}
          questProgress={questProgress}
          onFuse={handleFuseItem}
          onReset={handleReset}
          onUserItemSponsor={handleUserItemSponsor}
          appTheme={appTheme}
          setAppTheme={setAppTheme}
          theme={theme}
          marketData={marketData}
        />
      )}
    </div>
  );
}

